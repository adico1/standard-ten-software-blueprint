{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/adico1/standard-ten-software-blueprint/main/schemas/stsb.schema.json",
  "title": "Standard Ten Software Blueprint 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "identity", "function", "blueprint", "source", "composition", "builds"],
  "properties": {
    "schema": {"const": "stsb/0.1"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "family", "product", "version"],
      "properties": {
        "authority": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "family", "capabilities"],
      "properties": {
        "primary": {"$ref": "#/$defs/root"},
        "family": {"type": "string", "minLength": 1},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/root"}
        }
      }
    },
    "blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed_digest", "generator"],
      "properties": {
        "seed_digest": {"$ref": "#/$defs/sha256"},
        "generator": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["swhid"],
      "properties": {"swhid": {"type": "string", "pattern": "^swh:1:(cnt|dir|rev|rel|snp):[0-9a-f]{40}$"}}
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx"],
      "properties": {"spdx": {"type": "string", "minLength": 1}}
    },
    "builds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "digest", "reproducible"],
        "properties": {
          "target": {"type": "string", "minLength": 1},
          "digest": {"$ref": "#/$defs/sha256"},
          "reproducible": {"type": "boolean"}
        }
      }
    },
    "extensions": {"type": "object"}
  },
  "$defs": {
    "root": {
      "enum": ["compute", "record", "create", "observe", "communicate", "coordinate", "decide", "transact", "simulate", "control"]
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
